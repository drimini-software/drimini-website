---
import BaseLayout from "../layouts/BaseLayout.astro";

const testSiteKey = "1x00000000000000000000AA";
const isTestBuild = import.meta.env.MODE === "test";
const configuredSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

if (import.meta.env.PROD && !isTestBuild && !configuredSiteKey) {
  throw new Error("PUBLIC_TURNSTILE_SITE_KEY is required for a production build.");
}

const turnstileSiteKey = configuredSiteKey ?? testSiteKey;
---

<BaseLayout
  title="Contact us"
  description="Tell Drimini about a difficult software, systems, or website project."
  bodyClass="contact-page"
>
  <section class="page-intro shell" aria-labelledby="contact-title">
    <div>
      <p class="eyebrow">Contact us</p>
      <h1 id="contact-title">Tell us where the work gets difficult.</h1>
    </div>
    <p>
      A short outline is enough. Give us the outcome, the constraint, and any
      timing that matters. We can work out the rest together.
    </p>
  </section>

  <section class="contact-layout shell" aria-label="Project enquiry">
    <div class="contact-form">
      <form action="/api/contact" method="post" aria-label="Project enquiry" data-contact-form>
        <fieldset>
          <legend>Project details</legend>

          <div class="field-grid">
            <label>
              <span>Name <b aria-label="required">*</b></span>
              <input type="text" name="name" autocomplete="name" maxlength="100" required />
            </label>
            <label>
              <span>Work email <b aria-label="required">*</b></span>
              <input type="email" name="email" autocomplete="email" maxlength="254" required />
            </label>
            <label>
              <span>Company <b aria-label="required">*</b></span>
              <input type="text" name="company" autocomplete="organization" maxlength="160" required />
            </label>
            <label>
              <span>Role / title <small>Optional</small></span>
              <input type="text" name="role" autocomplete="organization-title" maxlength="120" />
            </label>
          </div>

          <label>
            <span>What do you need help with? <b aria-label="required">*</b></span>
            <textarea
              name="project"
              rows="7"
              minlength="20"
              maxlength="5000"
              placeholder="The outcome, what is getting in the way, and what a useful result would look like."
              required></textarea>
          </label>

          <div class="field-grid">
            <label>
              <span>Approximate timeline <small>Optional</small></span>
              <input type="text" name="timeline" maxlength="120" placeholder="A date or rough window is enough" />
            </label>
            <label>
              <span>Approximate budget <small>Optional</small></span>
              <input type="text" name="budget" maxlength="120" placeholder="A range is enough" />
            </label>
          </div>

          <label class="honeypot" aria-hidden="true">
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>

          <label class="consent-field">
            <input type="checkbox" name="consent" value="acknowledged" required />
            <span>
              I have read the <a href="/privacy">privacy notice</a> and understand how
              Drimini will use this information.
            </span>
          </label>

          <div class="turnstile-wrap">
            {isTestBuild ? (
              <input type="hidden" name="cf-turnstile-response" value="XXXX.DUMMY.TOKEN.XXXX" />
            ) : (
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-action="contact"
                data-theme="light"
              ></div>
            )}
          </div>

          <div class="form-actions">
            <button class="button button--primary" type="submit" data-submit-button>
              Send project outline
            </button>
            <p class="form-status" role="status" aria-live="polite" hidden data-form-status></p>
          </div>
        </fieldset>
      </form>
    </div>

    <aside class="contact-readiness" aria-labelledby="useful-context-title">
      <p class="eyebrow">Useful context</p>
      <h2 id="useful-context-title">Start with what matters.</h2>
      <p>
        You do not need a polished brief. The most useful first message makes the
        intended outcome and the awkward parts visible.
      </p>
      <ul>
        <li>The outcome you need</li>
        <li>What is blocking it today</li>
        <li>Systems or teams involved</li>
        <li>Timing or risk we should understand</li>
      </ul>
      <p class="contact-safety">
        Please do not send passwords, production credentials, regulated data, or
        other sensitive material through this form.
      </p>
      <a class="text-link" href="/">Return home <span aria-hidden="true">←</span></a>
    </aside>
  </section>

  {!isTestBuild && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
  <script is:inline src="/contact-form.js" defer></script>
</BaseLayout>
