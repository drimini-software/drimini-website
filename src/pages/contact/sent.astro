---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Message received"
  description="Drimini has received your project enquiry."
  bodyClass="contact-result-page"
  noIndex
>
  <section class="contact-result shell" aria-labelledby="sent-title">
    <p class="eyebrow">Message received</p>
    <h1 id="sent-title">Thanks. We have your outline.</h1>
    <p>If the work looks like a sensible fit, we will continue the conversation by email.</p>
    <a class="button button--primary" href="/">Return home</a>
  </section>
</BaseLayout>
